# Copy to .env (or export in your shell / CI) and edit. All values are optional
# except ANTHROPIC_API_KEY — every other setting has a working default.

# --- LLM provider -------------------------------------------------------------
# "openai"    -> any OpenAI-compatible endpoint (OpenAI, OpenRouter, avalai.ir…)
# "anthropic" -> native Claude API
LLM_PROVIDER=openai

# OpenAI-compatible provider (used when LLM_PROVIDER=openai). Do NOT commit the
# key — set it as an environment variable / GitHub Secret.
OPENAI_API_KEY=aa-CpjC4yY9J0XOzNvaG6v2KxYhha9PYn8Dz0slZrDrRcJjXO5m
OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_MODEL=gpt-4o-mini

# Native Claude API (used only when LLM_PROVIDER=anthropic).
# ANTHROPIC_API_KEY=sk-ant-...
WRITER_MODEL=claude-opus-5
WRITER_EFFORT=high
ANALYSIS_MODEL=claude-haiku-4-5

# --- Brand & language ---------------------------------------------------------
# BRAND_BRIEF="Omatekk is an AI accelerator..."   # overrides the built-in brief
OUTPUT_LANGUAGE=English

# Web-search grounding. Only available with LLM_PROVIDER=anthropic; automatically
# disabled in openai mode.
ENABLE_RESEARCH=true

# --- Sources (toggle on/off) --------------------------------------------------
SOURCE_GOOGLE_NEWS=true
SOURCE_RSS=true
SOURCE_REDDIT=true
SOURCE_HACKERNEWS=true
SOURCE_TWITTER=true
SOURCE_LINKEDIN=true

# Comma-separated. Defaults target the Omatekk / GCC startup beat.
# GN_QUERIES=Oman startup,GCC startup funding,MENA venture capital
# EXTRA_FEEDS=https://www.wamda.com/feed
# REDDIT_SUBREDDITS=startups,venturecapital,artificial
# HN_QUERIES=startup funding,venture capital,AI

# X / Twitter: official API v2. The twitter source activates only when this is set.
# X_BEARER_TOKEN=AAAA...

# LinkedIn has no public read API and scraping it violates their ToS. Point this
# at LinkedIn RSS bridges you control (e.g. an rss.app feed for a company page).
# LINKEDIN_FEEDS=https://rss.app/feeds/your-linkedin-feed.xml

# --- Collection tuning --------------------------------------------------------
HOURS_BACK=48
MAX_HEADLINES=60
MAX_CLUSTERS=12
CLUSTER_THRESHOLD=0.28
GNEWS_HL=en-US
GNEWS_GL=OM

# --- Persistence --------------------------------------------------------------
OUTPUT_DIR=output
STATE_DIR=state
HISTORY_DAYS=14
